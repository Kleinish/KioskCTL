#!/bin/sh
set -eu
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export KIOSKCTL_CONFIG=${KIOSKCTL_CONFIG:-/etc/kioskctl/config.yaml}
mkdir -p "$XDG_RUNTIME_DIR"
if command -v cage >/dev/null 2>&1; then exec cage -- /usr/local/bin/kioskctl --config "$KIOSKCTL_CONFIG" browser-session; fi
exec /usr/local/bin/kioskctl --config "$KIOSKCTL_CONFIG" browser-session
